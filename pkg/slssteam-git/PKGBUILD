# Maintainer: Ace! _SL/S <acesls@protonmail.com>
pkgname="slssteam-git"
pkgver=20261106120254
pkgrel=1
pkgdesc="Steamclient Mod"
arch=("x86_64")
url="https://github.com/AceSLS/SLSsteam"
license=("AGPL-3.0-only")

depends=("steam"
         "curl"
         "dbus"
         "libstdc++"
         "glibc"
         "systemd-libs"
         "dotnet-runtime")

makedepends=("make"
             "gcc"
             "pkg-config"
             "dotnet-sdk")

optdepends=("steam-native-runtime"
            "ccache: Speeds up compilation")

provides=("slssteam")
conflicts=("slssteam")

#Disable stripping to not mess up ticket-grabber
options=(!strip)

source=("git+$url#branch=dev")
sha256sums=("SKIP")
validpgpkeys=("63AB8F4BF8A62EEEB8D8C7584410F8CF7129B2D6")


pkgver() {
	cd "$srcdir/SLSsteam"
	git describe --long --tags --abbrev=7 | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
	cd "$srcdir/SLSsteam"
	make build
}

package() {
	cd "$srcdir/SLSsteam"
	PKGDIR="$pkgdir" make makepkg-install
}
