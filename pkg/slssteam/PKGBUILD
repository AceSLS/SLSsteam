# Maintainer: Ace! _SL/S <acesls@protonmail.com>
pkgname="slssteam"
pkgver=20261112130346
pkgrel=1
pkgdesc="Steamclient Mod"
arch=("x86_64")
url="https://github.com/AceSLS/SLSsteam"
license=("AGPL-3.0-only")

depends=("steam"
         "curl"
         "dbus"
         "libstdc++"
         "glibc"
         "systemd-libs"
         "dotnet-runtime")

makedepends=("make"
             "gcc"
             "pkg-config"
             "dotnet-sdk")

optdepends=("steam-native-runtime"
            "ccache: Speeds up compilation")

provides=("slssteam")
conflicts=("slssteam-git")

#Disable stripping to not mess up ticket-grabber
options=(!strip)

source=("$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('0e68b26306e3a5d8cff0a9804925cfa2b463961276a715795c4696f261a90d70')
validpgpkeys=("63AB8F4BF8A62EEEB8D8C7584410F8CF7129B2D6")


build() {
	cd "$srcdir/SLSsteam-$pkgver"
	make build
}

package() {
	cd "$srcdir/SLSsteam-$pkgver"
	PKGDIR="$pkgdir" make makepkg-install
}
